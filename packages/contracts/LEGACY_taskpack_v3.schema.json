{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofstep.local/schemas/taskpack-v3.json",
  "title": "ProofStep AI TaskPack v3 - design contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pack_id",
    "version",
    "review_status",
    "device_profile",
    "source_ids",
    "parts",
    "steps"
  ],
  "properties": {
    "pack_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "review_status": {
      "enum": [
        "DRAFT_UNVALIDATED",
        "REVIEW_REQUIRED",
        "REVIEWED_PUBLISHED"
      ]
    },
    "device_profile": {
      "type": "object",
      "required": [
        "domain",
        "exact_hardware_variant"
      ],
      "properties": {
        "domain": {
          "type": "string"
        },
        "exact_hardware_variant": {
          "type": "string"
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "safety_class": {
          "type": "string"
        }
      }
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "part_id",
          "name",
          "source_ids"
        ],
        "properties": {
          "part_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "geometry_asset_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "step_id",
          "instruction",
          "dependencies",
          "visible_requirements",
          "human_only_checks",
          "safety_restrictions"
        ],
        "properties": {
          "step_id": {
            "type": "string"
          },
          "instruction": {
            "type": "string"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "visible_requirements": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "predicate_id",
                "description",
                "evidence_type",
                "source_ids"
              ],
              "properties": {
                "predicate_id": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "evidence_type": {
                  "enum": [
                    "camera",
                    "measurement",
                    "human_check"
                  ]
                },
                "source_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "human_only_checks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "safety_restrictions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "virtual_asset_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "licenses_verified": {
      "type": "boolean"
    },
    "published_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "published_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
