{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generated Firmware/Software Artifact V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "project_id",
    "hardware_profile_id",
    "source_revision_ids",
    "artifact_version",
    "language",
    "files",
    "sha256",
    "state"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "hardware_profile_id": {
      "type": "string"
    },
    "source_revision_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifact_version": {
      "type": "integer",
      "minimum": 1
    },
    "language": {
      "type": "string"
    },
    "toolchain": {
      "type": [
        "string",
        "null"
      ]
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relative_path",
          "content_sha256"
        ],
        "properties": {
          "relative_path": {
            "type": "string",
            "pattern": "^[^/].*"
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "state": {
      "enum": [
        "DRAFT",
        "REVIEWED",
        "STATIC_CHECKED",
        "COMPILED",
        "FLASH_APPROVED",
        "USER_FLASHED",
        "DEVICE_OBSERVED",
        "VERIFIED_FOR_TESTED_CONDITIONS"
      ]
    },
    "build_attempt_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "approval_actor_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
