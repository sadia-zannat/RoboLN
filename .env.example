# Never commit real secrets. Local backend is loopback-only by default.
ROBOLN_DATABASE_URL=sqlite:///./roboln_dev.db
ROBOLN_COOKIE_SECURE=false
ROBOLN_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
ROBOLN_BACKEND_URL=http://127.0.0.1:8000
# Phase 02 only; do not configure until explicitly authorized.
MODEL_API_KEY=
